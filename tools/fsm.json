  "transitions": [
    {
      "from": "STATE_MAIN",
      "to": "STATE_DEAD",
      "trigger": "pet.isDead(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MAIN",
      "to": "STATE_MENU",
      "trigger": "input.isOkPressed(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MAIN",
      "to": "STATE_NPC_DIALOG",
      "trigger": "npcSelected",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MAIN",
      "to": "STATE_MENU",
      "trigger": "npcSelected",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MENU",
      "to": "STATE_ACTION_MENU",
      "trigger": "case 0",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MENU",
      "to": "STATE_DIGIMON_MENU",
      "trigger": "case 1",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MENU",
      "to": "STATE_SETTINGS",
      "trigger": "case 2",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MENU",
      "to": "STATE_MAIN",
      "trigger": "Exit -> main screen",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ACTION_MENU",
      "to": "STATE_MAIN",
      "trigger": "pet.isSleeping(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ACTION_MENU",
      "to": "STATE_MINIGAME",
      "trigger": "pet.isSleeping(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ACTION_MENU",
      "to": "STATE_MAIN",
      "trigger": "Sleep",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ACTION_MENU",
      "to": "STATE_MAIN",
      "trigger": "Clean",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ACTION_MENU",
      "to": "STATE_ADVENTURE_SELECT",
      "trigger": "Battle -> adventure area select",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ACTION_MENU",
      "to": "STATE_MENU",
      "trigger": "Back",
      "via": "onUpdate"
    },
    {
      "from": "STATE_DIGIMON_MENU",
      "to": "STATE_STATS_PAGE",
      "trigger": "case 0",
      "via": "onUpdate"
    },
    {
      "from": "STATE_DIGIMON_MENU",
      "to": "STATE_NPC_DIALOG",
      "trigger": "Training -> Pandamon NPC",
      "via": "onUpdate"
    },
    {
      "from": "STATE_DIGIMON_MENU",
      "to": "STATE_DIGIVOLUTION_PAGE",
      "trigger": "case 2",
      "via": "onUpdate"
    },
    {
      "from": "STATE_DIGIMON_MENU",
      "to": "STATE_MENU",
      "trigger": "Back",
      "via": "onUpdate"
    },
    {
      "from": "STATE_STATS_PAGE",
      "to": "STATE_DIGIMON_MENU",
      "trigger": "input.isOkPressed(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_DIGIVOLUTION_PAGE",
      "to": "STATE_MAIN",
      "trigger": "ok && req.target",
      "via": "onUpdate"
    },
    {
      "from": "STATE_DIGIVOLUTION_PAGE",
      "to": "STATE_DIGIMON_MENU",
      "trigger": "n == 0 || menu.selection == n",
      "via": "onUpdate"
    },
    {
      "from": "STATE_SETTINGS",
      "to": "STATE_MAIN",
      "trigger": "menu.selection == 1",
      "via": "onUpdate"
    },
    {
      "from": "STATE_SETTINGS",
      "to": "STATE_MENU",
      "trigger": "menu.selection == 2",
      "via": "onUpdate"
    },
    {
      "from": "STATE_DEAD",
      "to": "STATE_EGG_SELECT",
      "trigger": "menu.selection == 0",
      "via": "onUpdate"
    },
    {
      "from": "STATE_MINIGAME",
      "to": "STATE_MAIN",
      "trigger": "mgScore >= 5",
      "via": "onUpdate"
    },
    {
      "from": "STATE_NPC_DIALOG",
      "to": "STATE_MAIN",
      "trigger": "!dlg.isActive(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_NPC_DIALOG",
      "to": "STATE_TRAIN_RESULT",
      "trigger": "trainShowResult",
      "via": "onUpdate"
    },
    {
      "from": "STATE_NPC_DIALOG",
      "to": "STATE_MAIN",
      "trigger": "conversation finished",
      "via": "onUpdate"
    },
    {
      "from": "STATE_TRAIN_RESULT",
      "to": "STATE_NPC_DIALOG",
      "trigger": "back to Pandamon (\"Another round?\")",
      "via": "onUpdate"
    },
    {
      "from": "STATE_EGG_SELECT",
      "to": "STATE_MAIN",
      "trigger": "input.isOkPressed(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ADVENTURE_BATTLE",
      "to": "STATE_ADVENTURE_INTERLUDE",
      "trigger": "!combat.didWin(",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ADVENTURE_BATTLE",
      "to": "STATE_ADVENTURE_INTERLUDE",
      "trigger": "advRunHp > maxHp",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ADVENTURE_SELECT",
      "to": "STATE_ACTION_MENU",
      "trigger": "menu.selection == back",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ADVENTURE_SELECT",
      "to": "STATE_ADVENTURE_INTERLUDE",
      "trigger": "!adventure.startArea(menu.selection",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ADVENTURE_INTERLUDE",
      "to": "STATE_MAIN",
      "trigger": "advMode == ADV_CLEARED || advMode == ADV_DEFEAT",
      "via": "onUpdate"
    },
    {
      "from": "STATE_ADVENTURE_INTERLUDE",
      "to": "STATE_ADVENTURE_BATTLE",
      "trigger": "advSel == 0",
      "via": "onUpdate"
    }
  ],
  "source": "src/GameStateMachine.cpp"
}